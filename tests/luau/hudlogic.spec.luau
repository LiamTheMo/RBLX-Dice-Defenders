-- Match HUD logic: hearts, text, slot / summon states, visibility.

local HudLogic = require(game:GetService("StarterPlayer").StarterPlayerScripts.Client.Controllers.HudLogic)

local function hearts(lives, max)
	local f, e = HudLogic.hearts(lives, max)
	return f .. "/" .. e
end

test("hearts: full and empty from Lives and MaxLives", function()
	expectEq(hearts(3, 3), "3/0", "full")
	expectEq(hearts(2, 3), "2/1", "two")
	expectEq(hearts(1, 3), "1/2", "one")
	expectEq(hearts(0, 3), "0/3", "zero lives")
	expectEq(hearts(4, 5), "4/1", "other max")
	expectEq(hearts(1, 1), "1/0", "max one")
end)

test("hearts: clamp, nil, negative, NaN, above max", function()
	expectEq(hearts(5, 3), "5/0", "lives above max never lose a heart")
	expectEq(hearts(-2, 3), "0/3", "negative")
	expectEq(hearts(0 / 0, 3), "0/3", "NaN lives")
	expectEq(hearts(nil, 3), "0/3", "nil lives")
	expectEq(hearts(2, nil), "2/0", "nil max falls back to Lives")
	expectEq(hearts(nil, nil), "0/0", "both nil")
	expectEq(hearts(2, 0 / 0), "2/0", "NaN max")
	expectEq(hearts(2.7, 3), "2/1", "fractional floors")
	expectEq(hearts(1e300, 1e300), "10/0", "huge capped at MAX_HEARTS")
	expectEq(hearts(math.huge, 3), "10/0", "infinite lives")
end)

test("text: wave, MP with thousands separators, level, cost", function()
	expectEq(HudLogic.waveText(7), "WAVE 7", "wave")
	expectEq(HudLogic.waveText(nil), "WAVE 0", "nil wave")
	expectEq(HudLogic.mpText(12480), "12,480 MP", "separator")
	expectEq(HudLogic.mpText(999), "999 MP", "no separator")
	expectEq(HudLogic.mpText(1000), "1,000 MP", "exact thousand")
	expectEq(HudLogic.mpText(1234567), "1,234,567 MP", "millions")
	expectEq(HudLogic.mpText(nil), "0 MP", "nil")
	expectEq(HudLogic.mpText(-5), "0 MP", "negative")
	expectEq(HudLogic.mpText(0 / 0), "0 MP", "NaN")
	expectEq(HudLogic.mpText(1e300), "999,999,999 MP", "huge MP capped")
	expectEq(HudLogic.mpText(math.huge), "999,999,999 MP", "infinite MP capped")
	expectEq(HudLogic.levelText(3), "Lv 3", "level")
	expectEq(HudLogic.levelText(nil), "Lv 0", "nil level")
	expectEq(HudLogic.costText(nil), "MAX", "nil cost is maxed")
	expectEq(HudLogic.costText(1500), "1,500 MP", "cost")
end)

test("slotState: maxed, insufficient, idle", function()
	expectEq(HudLogic.slotState(nil, 100), "maxed", "nil Cost")
	expectEq(HudLogic.slotState(nil, nil), "maxed", "nil Cost and MP")
	expectEq(HudLogic.slotState(50, 49), "insufficient", "one short")
	expectEq(HudLogic.slotState(50, 50), "idle", "exact")
	expectEq(HudLogic.slotState(50, nil), "insufficient", "nil MP")
	expectEq(HudLogic.slotState(50, 0 / 0), "insufficient", "NaN MP")
	expectEq(HudLogic.slotState(50, 1e300), "idle", "huge MP")
	expectEq(HudLogic.slotState(0 / 0, 100), "insufficient", "NaN Cost")
end)

test("slotInfo: row to display fields", function()
	local info = HudLogic.slotInfo({ Id = "C01", Tier = 2, Cost = 120 }, 100)
	expectEq(info.State .. "|" .. info.LevelText .. "|" .. info.CostText, "insufficient|Lv 2|120 MP", "row")
	local maxed = HudLogic.slotInfo({ Id = "C01", Tier = 5 }, nil)
	expectEq(maxed.State .. "|" .. maxed.CostText, "maxed|MAX", "maxed row")
end)

test("summon: state and strings", function()
	expectEq(HudLogic.summonState(40, 40), "idle", "exact")
	expectEq(HudLogic.summonState(40, 39), "insufficient", "short")
	expectEq(HudLogic.summonState(nil, 100), "insufficient", "nil cost")
	expectEq(HudLogic.summonState(40, nil), "insufficient", "nil MP")
	expectEq(HudLogic.summonState(40, 0 / 0), "insufficient", "NaN MP")
	expectEq(HudLogic.summonState(40, math.huge), "idle", "infinite MP")
	expectEq(HudLogic.SUMMON_TEXT, "SUMMON", "label")
	expectEq(HudLogic.summonCostText(40), "40 MP", "cost")
	expectEq(HudLogic.summonCostText(nil), "0 MP", "nil cost text")
end)

test("visibility: Playing only; hint by wave; slots need rows", function()
	local v = HudLogic.visibility("Playing", 1, 5)
	expectEq(v.Bar and v.Summon and v.Slots and v.Hint, true, "playing wave 1")
	expectEq(HudLogic.visibility("Playing", 3, 5).Hint, false, "hint gone after wave 2")
	expectEq(HudLogic.visibility("Playing", 2, 0).Slots, false, "no rows")
	expectEq(HudLogic.visibility("Playing", 2, nil).Slots, false, "nil rows")
	for _, phase in { "Lobby", "Ended", "Loading", "Failed", "NotOwner" } do
		local o = HudLogic.visibility(phase, 1, 5)
		expectEq(o.Bar or o.Summon or o.Slots or o.Hint, false, phase)
	end
	expectEq(HudLogic.visibility(nil, nil, nil).Bar, false, "nil phase")
end)
