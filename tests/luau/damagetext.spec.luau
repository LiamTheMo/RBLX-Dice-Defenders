-- Floating damage text: abbreviated formatting, per-enemy coalescing window, live cap (drop, never queue).

local DamageText = require(game:GetService("StarterPlayer").StarterPlayerScripts.Client.Controllers.Effects.DamageText)

local ORIGIN = Vector3.new(0, 0, 0)

test("format: plain, K, M, B, truncation, junk", function()
	expectEq(DamageText.Format(0), "0", "zero")
	expectEq(DamageText.Format(950), "950", "plain")
	expectEq(DamageText.Format(999.9), "999", "fraction floors")
	expectEq(DamageText.Format(1000), "1K", "exact K")
	expectEq(DamageText.Format(1234), "1.2K", "1.2K")
	expectEq(DamageText.Format(1299), "1.2K", "truncates, never rounds up")
	expectEq(DamageText.Format(999999), "999.9K", "just under M")
	expectEq(DamageText.Format(3400000), "3.4M", "3.4M")
	expectEq(DamageText.Format(2000000000), "2B", "B")
	expectEq(DamageText.Format(-5), "0", "negative")
end)

test("coalesce: first hit is due at once, later hits wait for the window and are summed", function()
	local c = DamageText.newCoalescer(0.15)
	c.Add(1, ORIGIN, 10, false)
	local out = c.Flush(0, 40)
	expectEq(#out, 1, "first emits")
	expectEq(out[1].damage, 10, "damage")
	c.Add(1, ORIGIN, 5, false)
	c.Add(1, ORIGIN, 7, true)
	expectEq(#c.Flush(0.05, 40), 0, "inside window: held")
	out = c.Flush(0.16, 40)
	expectEq(#out, 1, "after window: one number")
	expectEq(out[1].damage, 12, "summed")
	expectEq(out[1].crit, true, "crit if any")
	expectEq(#c.Flush(0.5, 40), 0, "nothing pending")
end)

test("coalesce: enemies are independent and bad damage is ignored", function()
	local c = DamageText.newCoalescer(0.15)
	c.Add(1, ORIGIN, 3, nil)
	c.Add(2, ORIGIN, 4, nil)
	c.Add(3, ORIGIN, 0, nil)
	c.Add(3, ORIGIN, -2, nil)
	expectEq(#c.Flush(0, 40), 2, "two enemies, zero damage skipped")
end)

test("cap: over-room entries are dropped, not queued", function()
	local c = DamageText.newCoalescer(0.15)
	for id = 1, 10 do
		c.Add(id, ORIGIN, 1, false)
	end
	expectEq(#c.Flush(0, 4), 4, "only room worth")
	expectEq(#c.Flush(1, 40), 0, "the rest were dropped")
	c.Add(1, ORIGIN, 1, false)
	expectEq(#c.Flush(2, 0), 0, "no room emits nothing")
	expectEq(#c.Flush(3, 40), 0, "and that hit is gone")
end)

test("clear forgets pending hits and timestamps", function()
	local c = DamageText.newCoalescer(0.15)
	c.Add(1, ORIGIN, 1, false)
	c.Flush(0, 40)
	c.Add(1, ORIGIN, 1, false)
	c.Clear()
	expectEq(#c.Flush(0.01, 40), 0, "pending cleared")
	c.Add(1, ORIGIN, 2, false)
	expectEq(#c.Flush(0.02, 40), 1, "fresh enemy emits immediately")
end)
