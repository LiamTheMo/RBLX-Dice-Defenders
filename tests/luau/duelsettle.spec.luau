-- Rules/DuelSettle: DR and Gold for both seats of a finished Duel, judged against pre-match DR, once per run id.

local Server = game:GetService("ServerScriptService").Server
local DuelSettle = require(Server.Rules.DuelSettle)

local function profile(dr: number, streak: number?)
	local s = streak or 0
	return {
		Gold = 0,
		Rating = { DR = dr, Streak = s, BestStreak = s, Wins = 0, Losses = 0, Draws = 0, LastDuelRunId = 0 },
	}
end

test("winner gains DR and Gold, loser loses DR and nothing else", function()
	local a, b = profile(100), profile(100)
	local results = DuelSettle.Run({ a, b }, { 100, 100 }, { Winner = 1, Why = "Lives" }, 11)
	expectEq(results[1].Outcome, "Win", "seat 1")
	expectEq(results[2].Outcome, "Loss", "seat 2")
	expectEq(results[1].Why, "Lives", "why")
	expect(a.Rating.DR > 100 and b.Rating.DR < 100, "DR moved")
	expectEq(a.Gold, results[1].Gold, "gold credited")
	expect(a.Gold > 0, "winner paid")
	expectEq(b.Gold, 0, "loser unpaid")
end)

test("both seats use the opponent's pre-match DR", function()
	local a, b = profile(100), profile(900)
	local r = DuelSettle.Run({ a, b }, { 100, 900 }, { Winner = 1, Why = "Lives" }, 12)
	local solo = profile(100)
	local expected = DuelSettle.Run({ solo }, { 100, 900 }, { Winner = 1, Why = "Lives" }, 12)
	expectEq(r[1].DRDelta, expected[1].DRDelta, "same delta whichever seat is applied first")
	expectEq(r[2].Outcome, "Loss", "loser")
end)

test("applies once per run id", function()
	local a, b = profile(100), profile(100)
	DuelSettle.Run({ a, b }, { 100, 100 }, { Winner = 2, Why = "Forfeit" }, 14, 5)
	local drA, drB, goldB = a.Rating.DR, b.Rating.DR, b.Gold
	local again = DuelSettle.Run({ a, b }, { 100, 100 }, { Winner = 2, Why = "Forfeit" }, 14, 5)
	expectEq(again[1], nil, "no second result a")
	expectEq(again[2], nil, "no second result b")
	expectEq(a.Rating.DR, drA, "DR a stable")
	expectEq(b.Rating.DR, drB, "DR b stable")
	expectEq(b.Gold, goldB, "gold stable")
end)

test("a missing profile is skipped and the other seat still settles", function()
	local b = profile(100)
	local r = DuelSettle.Run({ nil, b }, { 100, 100 }, { Winner = 2, Why = "Forfeit" }, 15)
	expectEq(r[1], nil, "no result for the missing seat")
	expectEq(r[2].Outcome, "Win", "opponent of the leaver wins")
end)

test("outcomeFor", function()
	expectEq(DuelSettle.OutcomeFor({ Winner = 2 }, 2), "Win", "win")
	expectEq(DuelSettle.OutcomeFor({ Winner = 2 }, 1), "Loss", "loss")
	expectEq(DuelSettle.OutcomeFor({ Winner = 1, Why = "Tiebreak" }, 2), "Loss", "never a draw")
end)

test("an early forfeit costs the leaver but pays the winner nothing", function()
	local winner, leaver = profile(100, 3), profile(100, 2)
	local r = DuelSettle.Run({ winner, leaver }, { 100, 100 }, { Winner = 1, Why = "Forfeit" }, 20, 1)
	expectEq(r[1].Outcome, "Win", "display outcome")
	expectEq(r[1].Why, "EarlyForfeit", "why")
	expectEq(r[1].DRDelta, 0, "no DR")
	expectEq(r[1].Gold, 0, "no gold")
	expectEq(winner.Rating.DR, 100, "winner DR")
	expectEq(winner.Rating.Streak, 3, "winner streak")
	expectEq(winner.Rating.Wins, 0, "winner wins")
	expectEq(winner.Gold, 0, "winner gold")
	expectEq(r[2].Outcome, "Loss", "leaver loses")
	expect(leaver.Rating.DR < 100 and leaver.Rating.Streak == 0, "leaver pays")
end)

test("a late forfeit and a normal early win are unaffected", function()
	local a, b = profile(100), profile(100)
	local r = DuelSettle.Run({ a, b }, { 100, 100 }, { Winner = 1, Why = "Forfeit" }, 21, 3)
	expectEq(r[1].Why, "Forfeit", "late forfeit is a normal win")
	expect(a.Rating.DR > 100 and a.Gold > 0, "winner paid")
	local c, d = profile(100), profile(100)
	local r2 = DuelSettle.Run({ c, d }, { 100, 100 }, { Winner = 1, Why = "Lives" }, 22, 0)
	expectEq(r2[1].Why, "Lives", "lives win")
	expect(c.Rating.DR > 100, "winner paid")
end)

test("a surrender before MinWavesForRewards is an early forfeit", function()
	local winner, leaver = profile(100, 3), profile(100, 2)
	local r = DuelSettle.Run({ winner, leaver }, { 100, 100 }, { Winner = 1, Why = "Surrender" }, 30, 1)
	expectEq(r[1].Why, "EarlyForfeit", "why")
	expectEq(r[1].Gold, 0, "no gold")
	expectEq(winner.Rating.DR, 100, "winner DR")
	expect(leaver.Rating.DR < 100, "leaver pays")
	local c, d = profile(100), profile(100)
	local late = DuelSettle.Run({ c, d }, { 100, 100 }, { Winner = 1, Why = "Surrender" }, 31, 3)
	expectEq(late[1].Why, "Surrender", "late surrender is a normal win")
	expect(c.Rating.DR > 100 and c.Gold > 0, "winner paid")
end)

test("a bot seat has no profile: the human settles alone with goldFactor", function()
	local full = profile(100)
	local f = DuelSettle.Run({ full }, { 100, 100 }, { Winner = 1, Why = "Lives" }, 40)
	local half = profile(100)
	local h = DuelSettle.Run({ half }, { 100, 100 }, { Winner = 1, Why = "Lives" }, 41, 10, 0.5, true)
	expectEq(h[2], nil, "no result for the bot")
	expectEq(h[1].Gold, math.floor(f[1].Gold * 0.5), "gold halved, floored")
	expectEq(half.Gold, h[1].Gold, "credited")
	expectEq(h[1].DRDelta, f[1].DRDelta, "DR unaffected by goldFactor")
	expectEq(h[1].VsBot, true, "flagged")
	local none = profile(100)
	local z = DuelSettle.Run({ none }, { 100, 100 }, { Winner = 1, Why = "Lives" }, 42, 10, 0, true)
	expectEq(z[1].Gold, 0, "factor 0 pays nothing")
	expectEq(none.Gold, 0, "balance untouched")
	expect(none.Rating.DR > 100, "still gains DR")
	local loser = profile(100)
	local l = DuelSettle.Run({ loser, nil }, { 100, 100 }, { Winner = 2, Why = "Lives" }, 43, 10, 0.5, true)
	expectEq(l[1].Outcome, "Loss", "human loses to a bot")
	expectEq(loser.Rating.Draws, 0, "no draws")
end)
